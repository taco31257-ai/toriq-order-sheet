/**
 * 鳥久 × 隼｜店內管理系統 — Google 試算表雲端同步
 *
 * 第一次使用：
 *   1. 把下面 SYNC_KEY 改成你自己的同步密碼（店員手機第一次同步時要輸入）
 *   2. 上方函式選單選「setup」→ 執行 → 授權
 *   3.（選用）若隼的品項還沒在手機建立，可執行「seedHayabusa」匯入成本主表品項
 *   4. 部署 → 新增部署作業 → 網頁應用程式（執行身分：我；存取權：所有人）
 */
const SYNC_KEY = '請改成你的同步密碼';

const STORES = ['鳥久', '隼'];
const TZ = 'Asia/Taipei';
const SH = { vendors: '廠商', items: '品項', log: '叫貨紀錄', stats: '月統計', help: '使用說明' };
const HEAD = {
  vendors: ['門市', '廠商ID', '廠商', '送貨星期', '注意事項'],
  items: ['門市', '品項ID', '廠商ID', '廠商', '分類', '品名', '單價', '單位', '平日安全量', '假日安全量'],
  log: ['單號', '類型', '門市', '叫貨時間', '送貨日期', '廠商', '叫貨人', '品項', '數量', '單位', '單價', '小計', '原始資料']
};

/* ================= 初始化 ================= */
function setup() {
  const ss = SpreadsheetApp.getActive();
  ss.setSpreadsheetTimeZone(TZ);
  const v = ensureSheet_(SH.vendors, HEAD.vendors);
  v.hideColumns(2); v.setColumnWidth(3, 200); v.setColumnWidth(5, 320);
  const it = ensureSheet_(SH.items, HEAD.items);
  it.hideColumns(2, 2); it.setColumnWidth(4, 180); it.setColumnWidth(6, 260);
  const log = ensureSheet_(SH.log, HEAD.log);
  log.getRange('D:D').setNumberFormat('yyyy-mm-dd hh:mm');
  log.setColumnWidth(1, 120); log.setColumnWidth(8, 260); log.hideColumns(13);
  buildStats_(); buildHelp_();
  ['工作表1', 'Sheet1', '品項清單', '叫貨紀錄_舊'].forEach(n => {
    const s = ss.getSheetByName(n); if (s && n !== SH.log && s.getLastRow() <= 1 && ss.getSheets().length > 1) ss.deleteSheet(s);
  });
  ss.setActiveSheet(it);
}

function ensureSheet_(name, head) {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  if (sh.getLastRow() === 0) {
    sh.getRange(1, 1, 1, head.length).setValues([head]).setFontWeight('bold').setBackground('#e9eee7');
    sh.setFrozenRows(1);
  }
  return sh;
}

function buildStats_() {
  const ss = SpreadsheetApp.getActive();
  if (ss.getSheetByName(SH.stats)) return;
  const sh = ss.insertSheet(SH.stats);
  sh.getRange('A1:A2').setValues([['統計月份'], ['門市']]).setFontWeight('bold');
  sh.getRange('B1').setNumberFormat('@').setValue(Utilities.formatDate(new Date(), TZ, 'yyyy-MM'));
  sh.getRange('B2').setValue('');
  sh.getRange('C1').setValue('← 例 2026-11').setFontColor('#777777');
  sh.getRange('C2').setValue('← 鳥久 / 隼，空白＝兩店合計').setFontColor('#777777');
  const rng = "'" + SH.log + "'!A:L";
  const start = 'DATE(VALUE(LEFT($B$1,4)),VALUE(RIGHT($B$1,2)),1)';
  const where = " where D >= datetime '\"&TEXT(" + start + ",\"yyyy-mm-dd\")&\" 00:00:00' and D < datetime '\"&TEXT(EDATE(" + start + ",1),\"yyyy-mm-dd\")&\" 00:00:00' and H is not null\"&IF($B$2=\"\",\"\",\" and C = '\"&$B$2&\"'\")&\"";
  const q = (cols, tail) => '=IFERROR(QUERY(' + rng + ',"select ' + cols + where + tail + '",1),"本月尚無紀錄")';
  sh.getRange('A4').setValue('依廠商').setFontWeight('bold');
  sh.getRange('A5').setFormula(q('C, B, F, count(H), sum(L)', " group by C, B, F order by C, B, F label C '門市', B '類型', F '廠商', count(H) '品項筆數', sum(L) '估算金額'"));
  sh.getRange('H4').setValue('依品項（用量）').setFontWeight('bold');
  sh.getRange('H5').setFormula(q('C, F, H, J, sum(I), sum(L)', " group by C, F, H, J order by C, F, H label C '門市', F '廠商', H '品項', J '單位', sum(I) '總數量', sum(L) '估算金額'"));
  sh.getRange('P4').setValue('依叫貨人').setFontWeight('bold');
  sh.getRange('P5').setFormula(q('C, G, count(H), sum(L)', " group by C, G order by C label C '門市', G '叫貨人', count(H) '品項筆數', sum(L) '估算金額'"));
  sh.setFrozenRows(5);
}

function buildHelp_() {
  const ss = SpreadsheetApp.getActive();
  if (ss.getSheetByName(SH.help)) return;
  const sh = ss.insertSheet(SH.help);
  const t = [
    ['【資料從哪來】網頁上的「設定」改廠商／品項、按「複製並儲存紀錄」，都會自動同步到這份試算表；每支手機進入店別時會下載最新資料。'],
    ['【廠商、品項】可以直接在這裡改（名稱、單價、安全量、分類）。新增品項時「品項ID」留空即可，系統會自動補上。'],
    ['・分類只能填：炒、炸、烤、冷、備品、調味。'],
    ['・「門市」欄必填（鳥久 或 隼），兩店資料分開。'],
    ['・在網頁「設定」和試算表同時修改時，以最後存檔的一方為準。'],
    ['【叫貨紀錄】一個品項一列。要刪掉打錯的單，請在網頁「紀錄」裡按刪除（會同步刪除這裡）；或在這裡刪掉同一單號的所有列。'],
    ['・最後一欄「原始資料」（隱藏）是網頁還原紀錄用的，請勿修改。'],
    ['【月統計】B1 輸入月份、B2 輸入門市（空白＝兩店合計）。估算金額＝叫貨當下單價 × 數量，實際以廠商帳單為準。']
  ];
  sh.getRange(1, 1, t.length, 1).setValues(t).setWrap(true);
  sh.setColumnWidth(1, 780);
}

/* ================= API ================= */
function doGet(e) { return handle_((e && e.parameter) || {}); }
function doPost(e) {
  let body = {};
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ ok: false, error: '格式錯誤' }); }
  return handle_(body);
}

function handle_(p) {
  try {
    if (String(p.key || '') !== SYNC_KEY || SYNC_KEY === '請改成你的同步密碼') return json_({ ok: false, error: 'auth' });
    if (p.action === 'ping') return json_({ ok: true });
    if (STORES.indexOf(p.store) < 0) return json_({ ok: false, error: '門市不正確' });
    switch (p.action) {
      case 'master': return json_(getMaster_(p.store));
      case 'saveMaster': return json_(withLock_(() => saveMaster_(p.store, p.vendors, p.items)));
      case 'history': return json_(getHistory_(p.store, p.kind, p.from, p.to));
      case 'saveOrder': return json_(withLock_(() => saveOrder_(p.store, p.kind, p.order)));
      case 'deleteOrder': return json_(withLock_(() => deleteOrder_(p.store, p.id)));
    }
    return json_({ ok: false, error: '未知的動作' });
  } catch (err) {
    return json_({ ok: false, error: String(err && err.message || err) });
  }
}

function json_(o) { if (o && o.ok) o.sid = SpreadsheetApp.getActive().getId(); return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function withLock_(fn) { const l = LockService.getScriptLock(); l.waitLock(20000); try { return fn(); } finally { l.releaseLock(); } }
function sheet_(k) { return SpreadsheetApp.getActive().getSheetByName(SH[k]) || ensureSheet_(SH[k], HEAD[k]); }
function values_(k) { const sh = sheet_(k); const n = sh.getLastRow(); return n < 2 ? [] : sh.getRange(2, 1, n - 1, HEAD[k].length).getValues(); }
const num_ = v => (v === '' || v === null || v === undefined || isNaN(Number(v))) ? '' : Number(v);
const uuid_ = () => Utilities.getUuid();

/* 依門市取代資料列：保留其他門市的列，重新寫入本門市 */
function replaceStoreRows_(k, store, rows) {
  const sh = sheet_(k), w = HEAD[k].length;
  const keep = values_(k).filter(r => r[0] !== store);
  const all = keep.concat(rows);
  const n = sh.getLastRow();
  if (n > 1) sh.getRange(2, 1, n - 1, w).clearContent();
  if (all.length) sh.getRange(2, 1, all.length, w).setValues(all);
}

function getMaster_(store) {
  const vrows = values_('vendors').filter(r => r[0] === store && String(r[2]).trim());
  const irows = values_('items').filter(r => r[0] === store && String(r[5]).trim());
  let changed = false;
  const byName = {};
  const vendors = vrows.map(r => {
    if (!r[1]) { r[1] = uuid_(); changed = true; }
    const v = { id: String(r[1]), name: String(r[2]).trim(), days: String(r[3] || ''), note: String(r[4] || '') };
    byName[v.name] = v.id; return v;
  });
  const items = irows.map(r => {
    if (!r[1]) { r[1] = uuid_(); changed = true; }
    let vid = String(r[2] || '');
    if (!vid || !vendors.some(v => v.id === vid)) { vid = byName[String(r[3]).trim()] || ''; if (vid) { r[2] = vid; changed = true; } }
    return { id: String(r[1]), vendor: vid, name: String(r[5]).trim(), cat: String(r[4] || '備品'), price: Number(num_(r[6]) || 0),
      unit: String(r[7] || ''), week: String(r[8] === '' ? '' : r[8]), holiday: String(r[9] === '' ? '' : r[9]) };
  }).filter(i => i.vendor);
  if (changed) { replaceStoreRows_('vendors', store, vrows); replaceStoreRows_('items', store, irows); }
  return { ok: true, vendors: vendors, items: items };
}

function saveMaster_(store, vendors, items) {
  if (!Array.isArray(vendors) || !Array.isArray(items)) return { ok: false, error: '資料不完整' };
  const vname = {};
  const vrows = vendors.map(v => { vname[v.id] = v.name; return [store, String(v.id), String(v.name || ''), String(v.days || ''), String(v.note || '')]; });
  const irows = items.map(i => [store, String(i.id), String(i.vendor), vname[i.vendor] || '', String(i.cat || ''), String(i.name || ''),
    num_(i.price), String(i.unit || ''), num_(i.week), num_(i.holiday)]);
  replaceStoreRows_('vendors', store, vrows);
  replaceStoreRows_('items', store, irows);
  return { ok: true, vendors: vrows.length, items: irows.length };
}

function saveOrder_(store, kind, h) {
  if (!h || !h.id || !Array.isArray(h.lines) || !h.lines.length) return { ok: false, error: '資料不完整' };
  const sh = sheet_('log'), last = sh.getLastRow();
  if (last >= 2) {
    const ids = sh.getRange(2, 1, last - 1, 1).getValues();
    if (ids.some(r => String(r[0]) === String(h.id))) return { ok: true, dup: true };
  }
  const type = kind === 'wine' ? '酒類' : '食材';
  const time = h.date ? new Date(h.date) : new Date();
  const raw = JSON.stringify(h);
  if (raw.length > 49000) throw new Error('單筆紀錄過大');
  const rows = h.lines.map((l, idx) => {
    let name, qty, unit, price;
    if (kind === 'wine') { const d = l.d || {}; name = String(d.name || '').replace(/\n/g, ' ') + (d.ml ? ' ' + d.ml + 'ml' : ''); qty = num_(l.qty); unit = '瓶'; price = num_(d.cost); }
    else { name = String(l.name || ''); qty = num_(l.qty); unit = String(l.unit || ''); price = num_(l.price); }
    const sub = (qty !== '' && price !== '') ? Math.round(qty * price) : '';
    return [String(h.id), type, store, time, String(h.delivery || ''), String(h.vendor || ''), String(h.who || ''), name, qty, unit, price, sub, idx === 0 ? raw : ''];
  });
  sh.getRange(last + 1, 1, rows.length, HEAD.log.length).setValues(rows);
  return { ok: true, rows: rows.length };
}

function deleteOrder_(store, id) {
  const sh = sheet_('log'), n = sh.getLastRow();
  if (n < 2) return { ok: true, deleted: 0 };
  const vals = sh.getRange(2, 1, n - 1, 3).getValues();
  let del = 0;
  for (let i = vals.length - 1; i >= 0; i--) {
    if (String(vals[i][0]) === String(id) && vals[i][2] === store) { sh.deleteRow(i + 2); del++; }
  }
  return { ok: true, deleted: del };
}

function getHistory_(store, kind, from, to) {
  const type = kind === 'wine' ? '酒類' : '食材';
  const ok = s => /^\d{4}-\d{2}$/.test(s || '');
  const f = ok(from) ? from : '0000-00', t = ok(to) ? to : '9999-99';
  const orders = [];
  values_('log').forEach(r => {
    if (r[2] !== store || r[1] !== type || !r[12]) return;
    let h; try { h = JSON.parse(r[12]); } catch (e) { return; }
    const m = String(h.date || '').slice(0, 7);
    if (m < f || m > t) return;
    orders.push(h);
  });
  return { ok: true, orders: orders };
}

/* ================= 選用：匯入隼的成本主表品項 ================= */
function seedHayabusa() {
  const has = values_('items').some(r => r[0] === '隼');
  if (has) throw new Error('試算表裡已經有隼的品項，為避免覆蓋，這次不匯入。');
  const vmap = {}, vrows = [], irows = [];
  SEED_HAYABUSA.vendors.forEach(v => { const id = uuid_(); vmap[v[0]] = id; vrows.push(['隼', id, v[0], '', v[1]]); });
  SEED_HAYABUSA.items.forEach(i => irows.push(['隼', uuid_(), vmap[i[0]], i[0], i[1], i[2], i[3], i[4], i[5], i[6]]));
  replaceStoreRows_('vendors', '隼', vrows);
  replaceStoreRows_('items', '隼', irows);
  SpreadsheetApp.getActive().toast('已匯入隼：' + vrows.length + ' 家廠商、' + irows.length + ' 個品項');
}

